<Window x:Class="Radio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Radio"
        mc:Ignorable="d"
        Loaded="Window_Loaded"
        Title="Radio" Height="500" Width="800">
    <Grid>
        <StackPanel>
            <Canvas Height="200">
                <Label x:Name="Volume_out" Content="Volume: " Canvas.Left="104" Canvas.Top="55" Height="89" Width="578" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="50" />
                <Button Click="Volume_plus_Click" x:Name="Volume_plus" Content="+" Canvas.Left="0" Canvas.Top="0" Height="200" Width="74" FontSize="100"/>
                <Button Click="Volume_minus_Click" x:Name="Volume_minus" Content="-" Canvas.Left="725" Canvas.Top="0" Height="200" Width="70" FontSize="100" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <Line X1="0" X2="800" Y1="200" Y2="200" StrokeThickness="2" Stroke="Black"></Line>
            </Canvas>
            <Canvas Height="234">
                <Button Click="Button_Click" Content="+" Canvas.Left="0" Canvas.Top="0" Height="150" Width="74" FontSize="100" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Button Click="Button_Click_1" Content="-" Canvas.Left="725" Canvas.Top="0" Height="150" Width="70" FontSize="100" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                <StackPanel Height="175" Width="550" HorizontalAlignment="Left" Canvas.Left="131" VerticalAlignment="Center">
                    <Canvas x:Name="Regler_canvas" Height="175">

                    </Canvas>
                </StackPanel>
                <RadioButton IsChecked="True" x:Name="s1" Content="" Canvas.Left="150" Canvas.Top="180" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <RadioButton x:Name="s2" Content="" Canvas.Left="275" Canvas.Top="180" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <RadioButton x:Name="s3" Content="" Canvas.Left="400" Canvas.Top="180" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <RadioButton x:Name="s4" Content="" Canvas.Left="525" Canvas.Top="180" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <RadioButton x:Name="s5" Content="" Canvas.Left="650" Canvas.Top="180" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <Label x:Name="Aktive_radiosender" Content="" Canvas.Left="275" Canvas.Top="200" RenderTransformOrigin="0.297,0.159" Height="44" Width="215" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                <Button Click="Save_Click" x:Name="Save" Content="Save" Canvas.Left="720" Canvas.Top="194" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                <Button Click="Load_Click" x:Name="Load" Content="Load" Canvas.Left="720" Canvas.Top="214" HorizontalAlignment="Left" VerticalAlignment="Center"/>

            </Canvas>
        </StackPanel>
    </Grid>
</Window>
